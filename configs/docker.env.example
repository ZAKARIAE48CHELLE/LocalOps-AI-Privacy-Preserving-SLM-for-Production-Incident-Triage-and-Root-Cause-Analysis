# LocalOps AI — Docker Environment Configuration Example
# Copy to .env or configs/docker.env for local production overrides

# Service Ports & Networking
LOCALOPS_HOST=0.0.0.0
LOCALOPS_PORT=8000

# Logging & Privacy Controls
LOCALOPS_LOG_LEVEL=INFO
LOCALOPS_LOG_RAW_PAYLOADS=false

# Retrieval-Augmented Generation
LOCALOPS_RAG_ENABLED=true

# Offline & Local Model Caches
HF_CACHE_DIR=~/.cache/huggingface
HF_HUB_OFFLINE=0

# Concurrency & Resource Limits
LOCALOPS_CONCURRENCY_LIMIT=1
